      { href: '/vendor/staff',          icon: 'staff',    label: 'Staff'       },
      { href: '/vendor/store-setup',    icon: 'store',    label: 'Store Setup' },
      { href: '/vendor/settings',       icon: 'settings', label: 'Settings'   },
    ],
