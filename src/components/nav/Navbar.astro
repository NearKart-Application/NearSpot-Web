---
const path = Astro.url.pathname;
const desktopLinks = [
  { href: '/',       label: 'Discover' },
  { href: '/search', label: 'Search'   },
  { href: '/map',    label: 'Map'      },
  { href: '/video',  label: 'Videos'   },
];
---
<nav class="fixed top-0 inset-x-0 z-40 h-16 bg-white/95 backdrop-blur border-b border-gray-100 shadow-sm">
  <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 flex items-center gap-3">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <div class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center">
        <span class="text-gold font-black text-base">N</span>
      </div>
      <span class="font-bold text-navy text-lg hidden sm:block">NearSpot</span>
    </a>

    <!-- Location chip (all pages except home — home has its own location bar) -->
    <button id="nav-location-btn"
      class:list={["flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200 transition-colors min-w-0 max-w-[160px] sm:max-w-[200px]", path === '/' && "hidden"]}>
      <svg class="w-3.5 h-3.5 text-navy shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
      <span id="nav-location-name" class="text-xs font-semibold text-navy truncate">Detecting…</span>
      <svg class="w-3 h-3 text-gray-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
    </button>

    <!-- Desktop nav links -->
    <div class="hidden md:flex items-center gap-1 flex-1">
      {desktopLinks.map(link => (
        <a href={link.href}
           class:list={['px-3 py-1.5 rounded-lg text-sm font-medium transition-colors',
             path === link.href ? 'bg-navy text-white' : 'text-gray-600 hover:bg-gray-100 hover:text-navy']}>
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex-1 md:flex-none" />

    <!-- Right actions -->
    <div class="flex items-center gap-1">
      <!-- Mobile search shortcut -->
      <a href="/search" class="md:hidden w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-100 transition-colors text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </a>

      <!-- Notification bell -->
      <a id="nav-notif-link" href="/customer/notifications" class="relative w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-100 transition-colors text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.006 6.006 0 00-5.655-5.978A2 2 0 0010 6v.022A6.006 6.006 0 004 12v2.159c0 .537-.214 1.054-.595 1.436L2 17h5m8 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <span id="notif-badge" class="hidden absolute -top-0.5 -right-0.5 min-w-[16px] h-4 bg-red-500 text-white text-[9px] font-black rounded-full flex items-center justify-center px-1 leading-none"></span>
      </a>

      <!-- Wishlist heart -->
      <a href="/customer/wishlist" class="w-9 h-9 flex items-center justify-center rounded-xl hover:bg-gray-100 transition-colors text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </a>

      <!-- Auth: login btn or avatar -->
      <div id="nav-auth" class="flex items-center">
        <a href="/auth/login" class="btn-outline btn-sm hidden" id="nav-login">Sign In</a>
        <a href="/customer/profile" class="w-8 h-8 rounded-full bg-navy flex items-center justify-center text-white text-xs font-bold hidden" id="nav-avatar">U</a>
      </div>
    </div>
  </div>

  <!-- Mobile bottom tab bar -->
  <div class="md:hidden fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur border-t border-gray-100 flex z-40 safe-area-pb">
    <!-- Discover -->
    <a href="/"
       class:list={['flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors',
         path === '/' ? 'text-navy' : 'text-gray-400 hover:text-gray-600']}>
      <svg class="w-5 h-5" fill={path === '/' ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span class="text-[10px] font-semibold">Discover</span>
    </a>

    <!-- Search -->
    <a href="/search"
       class:list={['flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors',
         path === '/search' ? 'text-navy' : 'text-gray-400 hover:text-gray-600']}>
      <svg class="w-5 h-5" fill={path === '/search' ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <span class="text-[10px] font-semibold">Search</span>
    </a>

    <!-- Messages -->
    <a id="nav-messages-tab" href="/customer/chat"
       class:list={['flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors relative',
         path === '/customer/chat' ? 'text-navy' : 'text-gray-400 hover:text-gray-600']}>
      <svg class="w-5 h-5" fill={path === '/customer/chat' ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
      </svg>
      <span class="text-[10px] font-semibold">Messages</span>
      <span id="chat-badge" class="hidden absolute top-1.5 right-[calc(50%-10px)] w-4 h-4 bg-red-500 text-white text-[9px] font-black rounded-full flex items-center justify-center"></span>
    </a>

    <!-- Videos -->
    <a href="/video"
       class:list={['flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors',
         path === '/video' ? 'text-navy' : 'text-gray-400 hover:text-gray-600']}>
      <svg class="w-5 h-5" fill={path === '/video' ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
      </svg>
      <span class="text-[10px] font-semibold">Videos</span>
    </a>

    <!-- Profile -->
    <a href="/customer/profile"
       class:list={['flex-1 flex flex-col items-center justify-center py-2 gap-0.5 transition-colors',
         path.startsWith('/customer/profile') ? 'text-navy' : 'text-gray-400 hover:text-gray-600']}>
      <svg class="w-5 h-5" fill={path.startsWith('/customer/profile') ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span class="text-[10px] font-semibold">Profile</span>
    </a>
  </div>
</nav>

<script>
  // Auth state
  const user      = localStorage.getItem('ns_user');
  const loginBtn  = document.getElementById('nav-login');
  const avatarBtn = document.getElementById('nav-avatar');

  let userRole = 'customer';
  if (user) {
    try {
      const parsed = JSON.parse(user);
      userRole = parsed.role ?? parsed.ui_mode ?? 'customer';
      // Update avatar initial from latest profile edit if available
      const storedName = localStorage.getItem('ns_display_name') ?? parsed.full_name;
      avatarBtn!.textContent = (storedName?.[0] ?? 'U').toUpperCase();
      avatarBtn!.classList.remove('hidden');
    } catch { loginBtn!.classList.remove('hidden'); }
  } else {
    loginBtn!.classList.remove('hidden');
  }

  // Role-aware links
  const isVendor = userRole === 'vendor';
  const notifLink = document.getElementById('nav-notif-link') as HTMLAnchorElement | null;
  const messagesTab = document.getElementById('nav-messages-tab') as HTMLAnchorElement | null;
  if (notifLink) notifLink.href = isVendor ? '/vendor/notifications' : '/customer/notifications';
  if (messagesTab) {
    messagesTab.href = isVendor ? '/vendor/dashboard' : '/customer/chat';
    const label = messagesTab.querySelector('span');
    if (label && isVendor) label.textContent = 'Store';
  }

  // Location chip: read from localStorage, listen for changes
  function updateLocationChip(name: string) {
    const el = document.getElementById('nav-location-name');
    if (el) el.textContent = name || 'Set location';
  }

  // Try to show a saved location name
  (async function initLocation() {
    try {
      const raw = localStorage.getItem('ns_coords');
      if (raw) {
        const c = JSON.parse(raw);
        // Quick reverse geocode to get area name
        const r = await fetch(
          `https://nominatim.openstreetmap.org/reverse?format=json&lat=${c.lat}&lon=${c.lng}&zoom=14`,
          { headers: { 'Accept-Language': 'en' } }
        );
        const d = await r.json();
        const a = d.address ?? {};
        const name = a.suburb ?? a.neighbourhood ?? a.town ?? a.city_district ?? a.city ?? a.county ?? 'Your Area';
        updateLocationChip(name);
      } else {
        updateLocationChip('Set location');
      }
    } catch { updateLocationChip('Set location'); }
  })();

  // When location changes globally, update the chip
  document.addEventListener('ns:location-changed', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.name) updateLocationChip(detail.name);
  });

  // Open location picker on chip click
  document.getElementById('nav-location-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new Event('ns:open-location-picker'));
  });

  // Notification badge
  const token = localStorage.getItem('ns_access');
  if (token) {
    fetch('/api/v1/notifications/unread-count/', {
      headers: { Authorization: `Bearer ${token}` },
    })
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        const count = data?.unread_count ?? 0;
        const badge = document.getElementById('notif-badge');
        if (badge && count > 0) {
          badge.textContent = count > 99 ? '99+' : String(count);
          badge.classList.remove('hidden');
        }
      })
      .catch(() => {});

    // Unread chat count for Messages tab badge
    fetch('/api/v1/conversations/', {
      headers: { Authorization: `Bearer ${token}` },
    })
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        const convs = data?.results ?? (Array.isArray(data) ? data : []);
        const unread = convs.reduce((sum: number, c: any) => sum + (c.my_unread_count ?? 0), 0);
        const chatBadge = document.getElementById('chat-badge');
        if (chatBadge && unread > 0) {
          chatBadge.textContent = unread > 9 ? '9+' : String(unread);
          chatBadge.classList.remove('hidden');
        }
      })
      .catch(() => {});
  }
</script>
