---
import AppLayout from '../../layouts/AppLayout.astro';
import ProductDetailIsland from '../../components/islands/ProductDetailIsland';

const { id } = Astro.params;
const base = (import.meta.env.API_BASE as string | undefined)
  ?? (process.env.API_BASE ?? 'http://localhost:8000/api/v1');

let product: any = null;
try {
  const r = await fetch(`${base}/products/${id}/`);
  if (r.ok) product = await r.json();
} catch {}

const title = product?.name ?? 'Product';
---
<AppLayout title={title} fullWidth noFooter>
  <ProductDetailIsland client:load productId={id!} initialProduct={product} />
</AppLayout>
