---
import AuthLayout from '../../layouts/AuthLayout.astro';
const isDev = import.meta.env.DEV;
---
<AuthLayout title="Sign In">

  <h2 class="text-2xl font-black text-navy mb-1">Welcome back 👋</h2>
  <p class="text-gray-500 text-sm mb-7">Enter your mobile number to get OTP</p>

  <form id="login-form" class="space-y-4">
    <!-- Phone input -->
    <div>
      <label class="label" for="phone">Mobile Number</label>
      <div class="flex gap-2">
        <select id="country-code" class="input w-28 shrink-0 bg-gray-50 text-sm font-semibold text-gray-700 cursor-pointer pr-1">
          <option value="+91">🇮🇳 +91</option>
          <option value="+1">🇺🇸 +1</option>
          <option value="+44">🇬🇧 +44</option>
          <option value="+61">🇦🇺 +61</option>
          <option value="+971">🇦🇪 +971</option>
          <option value="+966">🇸🇦 +966</option>
          <option value="+65">🇸🇬 +65</option>
          <option value="+60">🇲🇾 +60</option>
          <option value="+92">🇵🇰 +92</option>
          <option value="+880">🇧🇩 +880</option>
          <option value="+94">🇱🇰 +94</option>
          <option value="+977">🇳🇵 +977</option>
          <option value="+49">🇩🇪 +49</option>
          <option value="+33">🇫🇷 +33</option>
          <option value="+81">🇯🇵 +81</option>
        </select>
        <input id="phone" name="phone" type="tel" inputmode="numeric"
               placeholder="9876543210"
               class="input flex-1 text-base font-medium tracking-wide" required autofocus />
      </div>
    </div>

    <div id="form-error" class="hidden text-red-600 text-sm bg-red-50 border border-red-100 rounded-xl px-4 py-3"></div>

    <button type="submit" id="submit-btn" class="btn-primary w-full py-3.5 text-base mt-2">
      <span id="btn-text">Get OTP</span>
      <span id="btn-spinner" class="hidden spinner w-4 h-4"></span>
    </button>
  </form>

  <div class="flex items-center gap-3 my-6">
    <div class="flex-1 h-px bg-gray-100"></div>
    <span class="text-xs text-gray-400 font-medium">OR</span>
    <div class="flex-1 h-px bg-gray-100"></div>
  </div>

  <!-- Google Sign-In -->
  <button id="google-btn"
          class="w-full flex items-center justify-center gap-3 border border-gray-200 rounded-2xl py-3 px-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
    <svg width="18" height="18" viewBox="0 0 48 48">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>
    Continue with Google
  </button>
  <div id="google-error" class="hidden text-red-600 text-xs text-center mt-2"></div>

  <div class="flex items-center gap-3 my-5">
    <div class="flex-1 h-px bg-gray-100"></div>
    <span class="text-xs text-gray-400 font-medium">NEW TO NEARSPOT?</span>
    <div class="flex-1 h-px bg-gray-100"></div>
  </div>

  <a href="/auth/signup"
     class="btn-outline w-full py-3 text-base text-center block">
    Create Account
  </a>

  <!-- Admin password login link -->
  <div class="mt-6 text-center">
    <a href="/admin/login"
       class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-navy transition-colors">
      <span>🛡️</span>
      <span>Admin? Sign in with password</span>
    </a>
  </div>

  <!-- ── Dev Test Credentials (development only) ─────────── -->
  {isDev && <div class="mt-8 border border-dashed border-gray-200 rounded-2xl overflow-hidden">
    <button id="dev-toggle"
            class="w-full flex items-center justify-between px-4 py-3 bg-gray-50 text-left">
      <div class="flex items-center gap-2">
        <span class="text-base">🧪</span>
        <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Dev Test Accounts</span>
      </div>
      <span id="dev-chevron" class="text-gray-400 text-sm transition-transform duration-200">▼</span>
    </button>

    <div id="dev-panel" class="hidden px-4 pb-4 pt-2 space-y-2">
      <p class="text-xs text-gray-400 mb-3">Click any account to auto-fill the number</p>

      <p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-1.5 mb-3 flex items-center gap-1.5">
        <span>⚠️</span> All accounts use OTP <strong>123456</strong> (debug mode)
      </p>

      <!-- Customers -->
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mt-2">Customers</p>
      {[
        { name: 'Dev Customer',  phone: '8888888888' },
        { name: 'Arjun Kumar',   phone: '9000000001' },
        { name: 'Priya Sharma',  phone: '9000000002' },
        { name: 'Rahul Verma',   phone: '9000000003' },
      ].map(u => (
        <button class="dev-fill w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl border border-gray-100 hover:border-navy hover:bg-navy/5 transition-all text-left group"
                data-phone={u.phone} data-otp="123456">
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-7 h-7 bg-blue-100 rounded-lg flex items-center justify-center text-sm shrink-0">👤</div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-navy truncate">{u.name}</p>
              <p class="text-xs text-gray-400">+91 {u.phone}</p>
            </div>
          </div>
          <div class="shrink-0 text-right">
            <p class="text-xs text-gray-400">OTP</p>
            <p class="text-sm font-bold text-navy tracking-widest">123456</p>
          </div>
        </button>
      ))}

      <!-- Vendors -->
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mt-3">Vendors</p>
      {[
        { name: 'Dev Vendor',   phone: '9999999999', store: 'NearKart Demo Hub' },
        { name: 'Sneha Reddy',  phone: '9000000004', store: "Sneha's Fashion House" },
        { name: 'Vikram Iyer',  phone: '9000000005', store: 'Vikram Electronics' },
        { name: 'Kiran Naidu',  phone: '9000000007', store: 'Kiran Footwear Zone' },
        { name: 'Divya Mehta',  phone: '9000000008', store: "Divya's Jewellery Corner" },
      ].map(u => (
        <button class="dev-fill w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl border border-gray-100 hover:border-gold hover:bg-gold/5 transition-all text-left group"
                data-phone={u.phone} data-otp="123456">
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-7 h-7 bg-yellow-100 rounded-lg flex items-center justify-center text-sm shrink-0">🏪</div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-navy truncate">{u.name}</p>
              <p class="text-xs text-gray-400 truncate">{u.store}</p>
            </div>
          </div>
          <div class="shrink-0 text-right">
            <p class="text-xs text-gray-400">OTP</p>
            <p class="text-sm font-bold text-navy tracking-widest">123456</p>
          </div>
        </button>
      ))}

      <!-- Admins -->
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mt-3">Admins</p>
      {[
        { name: 'Dev Admin',   phone: '7000000001', label: 'City Admin · Hyderabad' },
        { name: 'Dev Master',  phone: '7000000002', label: 'Master Admin · Full Access' },
      ].map(u => (
        <button class="dev-fill w-full flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl border border-gray-100 hover:border-navy hover:bg-navy/5 transition-all text-left group"
                data-phone={u.phone} data-otp="123456">
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-7 h-7 rounded-lg flex items-center justify-center text-sm shrink-0"
                 style="background:#1C2E4A10">🛡️</div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-navy truncate">{u.name}</p>
              <p class="text-xs text-gray-400 truncate">{u.label}</p>
            </div>
          </div>
          <div class="shrink-0 text-right">
            <p class="text-xs text-gray-400">OTP</p>
            <p class="text-sm font-bold text-navy tracking-widest">123456</p>
          </div>
        </button>
      ))}
    </div>
  </div>}

</AuthLayout>

<script>
  // ── Form submission ──────────────────────────────────────────────────────────
  const form        = document.getElementById('login-form') as HTMLFormElement;
  const btnText     = document.getElementById('btn-text')!;
  const spinner     = document.getElementById('btn-spinner')!;
  const submitBtn   = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorBox    = document.getElementById('form-error')!;
  const phoneInp    = document.getElementById('phone') as HTMLInputElement;
  const countryCode = document.getElementById('country-code') as HTMLSelectElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const digits = phoneInp.value.trim().replace(/\D/g, '');
    const cc     = countryCode.value;
    if (digits.length < 6 || digits.length > 13) { showError('Enter a valid phone number'); return; }
    const fullPhone = `${cc}${digits}`;

    setLoading(true);
    errorBox.classList.add('hidden');
    try {
      let res: Response;
      try {
        res = await fetch('/api/v1/auth/otp/send/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone_number: fullPhone, is_signup: false }),
        });
      } catch {
        throw new Error('Cannot reach server. Make sure the backend is running.');
      }
      if (!res.ok) {
        const d = await res.json().catch(() => ({}));
        // Handle DRF field-level errors (e.g. {phone_number: ["..."]})
        const fieldErr = Object.values(d).flat().join(' ');
        throw new Error(d.detail ?? d.message ?? fieldErr || 'Failed to send OTP');
      }
      window.location.href = `/auth/otp?phone=${encodeURIComponent(fullPhone)}`;
    } catch (err: any) {
      showError(err.message ?? 'Something went wrong. Try again.');
    } finally {
      setLoading(false);
    }
  });

  function setLoading(v: boolean) {
    submitBtn.disabled = v;
    btnText.textContent = v ? 'Sending OTP…' : 'Get OTP';
    spinner.classList.toggle('hidden', !v);
  }
  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  // ── Dev panel toggle ─────────────────────────────────────────────────────────
  const devToggle = document.getElementById('dev-toggle')!;
  const devPanel  = document.getElementById('dev-panel')!;
  const devChevron = document.getElementById('dev-chevron')!;
  devToggle.addEventListener('click', () => {
    const open = devPanel.classList.toggle('hidden');
    devChevron.style.transform = open ? '' : 'rotate(180deg)';
  });

  // ── Google Sign-In ───────────────────────────────────────────────────────────
  const GOOGLE_CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
  const googleBtn   = document.getElementById('google-btn') as HTMLButtonElement;
  const googleError = document.getElementById('google-error')!;

  if (GOOGLE_CLIENT_ID) {
    // Load Google Identity Services
    const gsiScript = document.createElement('script');
    gsiScript.src = 'https://accounts.google.com/gsi/client';
    gsiScript.async = true;
    document.head.appendChild(gsiScript);

    gsiScript.onload = () => {
      (window as any).google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,
        callback:  handleGoogleCredential,
        ux_mode:   'popup',
      });
    };

    googleBtn.addEventListener('click', () => {
      googleError.classList.add('hidden');
      (window as any).google?.accounts?.id?.prompt();
    });
  } else {
    googleBtn.classList.add('hidden');
  }

  async function handleGoogleCredential(response: any) {
    try {
      googleBtn.disabled = true;
      const res = await fetch('/api/v1/auth/social/google/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_token: response.credential }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message ?? 'Google sign-in failed');

      localStorage.setItem('ns_access',  data.access);
      localStorage.setItem('ns_refresh', data.refresh);
      const rawUser = data.user ?? {};
      const resolvedMode = rawUser.role ?? '';
      localStorage.setItem('ns_user', JSON.stringify({
        ...rawUser, ui_mode: resolvedMode, role: resolvedMode,
        is_vendor: resolvedMode === 'vendor',
        is_admin:  resolvedMode === 'admin' || resolvedMode === 'master_admin',
        avatar_url: rawUser.avatar ?? '',
      }));

      if (data.is_new || !resolvedMode) { window.location.href = '/auth/role-select'; return; }
      const redirectMap: Record<string, string> = { customer: '/', vendor: '/vendor/dashboard', admin: '/admin/dashboard', master_admin: '/admin/dashboard' };
      window.location.href = redirectMap[resolvedMode] ?? '/';
    } catch (err: any) {
      googleError.textContent = err.message ?? 'Google sign-in failed. Try again.';
      googleError.classList.remove('hidden');
      googleBtn.disabled = false;
    }
  }

  // ── Dev fill buttons ─────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.dev-fill').forEach(btn => {
    btn.addEventListener('click', () => {
      const phone = btn.dataset.phone ?? '';
      const otp   = btn.dataset.otp   ?? '';
      phoneInp.value = phone;
      countryCode.value = '+91';
      sessionStorage.setItem('ns_dev_otp', otp);
      btn.style.borderColor = '#1C2E4A';
      setTimeout(() => form.requestSubmit(), 150);
    });
  });
</script>
