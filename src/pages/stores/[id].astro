---
import AppLayout from '../../layouts/AppLayout.astro';
import StoreDetailIsland from '../../components/islands/StoreDetailIsland';

const { id } = Astro.params;

// SSR fetch — try both dev (localhost) and prod (django container) base URLs
const base = (import.meta.env.API_BASE as string | undefined)
  ?? (process.env.API_BASE ?? 'http://localhost:8000/api/v1');
let store: any = null;
try {
  const r = await fetch(`${base}/stores/${id}/`);
  if (r.ok) store = await r.json();
} catch {}

// Don't redirect — let the client-side island handle 404s gracefully
const title = store?.name ?? 'Store';

// JSON-LD LocalBusiness structured data for SEO
const jsonLd = store ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': store.name,
  'description': store.description ?? '',
  'image': store.cover_image ?? store.avatar ?? '',
  'telephone': store.phone ?? '',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': store.address ?? '',
    'addressLocality': store.location ?? '',
    'addressCountry': 'IN',
  },
  ...(store.lat && store.lng ? {
    'geo': { '@type': 'GeoCoordinates', 'latitude': store.lat, 'longitude': store.lng },
  } : {}),
  ...(store.rating ? {
    'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': store.rating,
      'reviewCount': store.review_count ?? 0,
    },
  } : {}),
  'openingHoursSpecification': (store.weekly_hours ?? [])
    .filter((h: any) => !h.is_closed)
    .map((h: any) => ({
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'][h.day],
      'opens': h.open_time,
      'closes': h.close_time,
    })),
  'url': `${Astro.url.origin}/stores/${id}`,
}) : null;
---
<AppLayout title={title} fullWidth noFooter>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} slot="head" />}
  <StoreDetailIsland client:load storeId={id!} initialStore={store} />
</AppLayout>
