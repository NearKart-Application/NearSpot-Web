---
import '../styles/global.css';
import { getLang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const { title = 'NearSpot', description = 'Discover local stores & deals near you', ogImage = '/og.png' } = Astro.props;
const pageTitle = title === 'NearSpot' ? 'NearSpot' : `${title} | NearSpot`;
const lang = getLang(Astro.request);

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'NearSpot',
  'url': 'https://nearspot.in',
  'description': 'Discover hyperlocal stores, products, and deals near you.',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': { '@type': 'EntryPoint', 'urlTemplate': 'https://nearspot.in/search?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
});
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'NearSpot',
  'url': 'https://nearspot.in',
  'logo': 'https://nearspot.in/icons/icon-512.png',
  'sameAs': [],
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content="website" />
    <meta name="theme-color"        content="#0F172A" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={websiteJsonLd} />
    <script type="application/ld+json" set:html={orgJsonLd} />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Global "Server Unavailable" overlay — shown when the backend API is unreachable
         (fully opaque so nothing behind shows through). Mirrors the offline SW page. -->
    <div id="nsd-overlay" class="nsd-overlay" hidden>
      <div class="nsd-card">
        <div class="nsd-logo">Near<span>Spot</span></div>
        <div class="nsd-status"><span class="nsd-dot"></span>Not connected</div>
        <h1 class="nsd-title">Server unavailable</h1>
        <p class="nsd-sub">We can't reach NearSpot right now. Please check your connection — we'll be back shortly.</p>
        <div class="nsd-div"></div>
        <div class="nsd-emoji">🛍️</div>
        <h2 class="nsd-h2">Play Deal or Skip while you wait</h2>
        <p class="nsd-gsub">Spot the best deals and beat your high score.<br><b>Play live to win real coupons 🎟️</b></p>
        <a class="nsd-btn nsd-play" href="/play">Play now</a>
        <button class="nsd-btn nsd-retry" id="nsd-retry">Retry connection</button>
      </div>
    </div>

    <script>
      // Register the PWA service worker (dev + prod) so the offline "Server Unavailable"
      // screen + Deal-or-Skip game work everywhere. The SW is network-first for HTML/JS,
      // so live changes still load fresh online; it only serves cache when truly offline.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
      // Show the Server Unavailable overlay when the backend is unreachable
      (function () {
        var ov = document.getElementById('nsd-overlay');
        if (!ov) return;
        window.addEventListener('ns:server-unavailable', function () { ov.hidden = false; });
        var retry = document.getElementById('nsd-retry');
        if (retry) retry.addEventListener('click', function () { location.reload(); });
      })();
    </script>
    <script>
      // Cross-tab session sync: when ns_user changes in another tab, react immediately.
      // The 'storage' event only fires in tabs that did NOT make the change — that's exactly what we need.
      window.addEventListener('storage', (e: StorageEvent) => {
        // Ignore events from auth pages — they manage their own redirects
        if (window.location.pathname.startsWith('/auth')) return;
        if (e.key !== 'ns_user') return;

        let prev: { ui_mode?: string } | null = null;
        let next: { ui_mode?: string } | null = null;
        try { prev = e.oldValue ? JSON.parse(e.oldValue) : null; } catch { prev = null; }
        try { next = e.newValue ? JSON.parse(e.newValue) : null; } catch { next = null; }

        if (!next || !localStorage.getItem('ns_access')) {
          // Logged out in another tab — go home (browse mode, no login required)
          window.location.href = '/';
          return;
        }

        const prevRole = prev?.ui_mode ?? '';
        const nextRole = next?.ui_mode ?? 'customer';

        if (prevRole !== nextRole) {
          // A different role just logged in — redirect this tab to that role's home
          const dest: Record<string, string> = {
            vendor: '/vendor/dashboard',
            admin: '/admin/dashboard',
            master_admin: '/admin/dashboard',
          };
          window.location.href = dest[nextRole] ?? '/';
        }
      });
    </script>

    <style is:global>
      .nsd-overlay{position:fixed;inset:0;z-index:99999;background:#080d16;
        display:flex;align-items:center;justify-content:center;padding:24px;
        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#fff}
      .nsd-overlay[hidden]{display:none}
      .nsd-card{max-width:340px;width:100%;background:#111f31;border:1px solid #243d59;border-radius:22px;
        padding:30px 26px;text-align:center;box-shadow:0 24px 60px rgba(0,0,0,.55)}
      .nsd-logo{font-size:16px;font-weight:800;color:#64748b;margin-bottom:24px}
      .nsd-logo span{color:#f5a623}
      .nsd-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:7px;
        vertical-align:middle;animation:nsd-blink 1.6s ease-in-out infinite}
      @keyframes nsd-blink{0%,100%{opacity:1}50%{opacity:.25}}
      .nsd-status{font-size:12px;color:#8aa0b8;font-weight:600;margin-bottom:10px}
      .nsd-title{font-size:22px;font-weight:800;color:#f1f5f9;margin-bottom:10px}
      .nsd-sub{font-size:13px;color:#7c92ab;line-height:1.6;margin-bottom:0}
      .nsd-div{height:1px;background:#223f5c;margin:26px -26px 20px}
      .nsd-emoji{font-size:22px;margin-bottom:5px}
      .nsd-h2{font-size:13.5px;font-weight:700;color:#e2e8f0;margin-bottom:4px}
      .nsd-gsub{font-size:11.5px;color:#7c92ab;line-height:1.5;margin-bottom:16px}
      .nsd-gsub b{color:#f5a623;font-weight:700}
      .nsd-btn{display:block;width:100%;padding:13px;border-radius:13px;cursor:pointer;border:none;
        font-size:14px;font-weight:800;text-decoration:none;transition:opacity .15s}
      .nsd-btn:active{opacity:.85}
      .nsd-play{background:#f5a623;color:#0c1a2e}
      .nsd-retry{background:transparent;color:#8aa0b8;border:1px solid #2a476b;margin-top:10px}
    </style>
  </body>
</html>

